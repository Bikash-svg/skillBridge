# Server
PORT=3000

# CORS -- only needed if the frontend is hosted on a different origin than
# this API (e.g. a separate static site + this as its own web service).
# Comma-separated list of allowed frontend origins. Leave empty to allow
# any origin, which is fine when Express also serves the frontend itself.
ALLOWED_ORIGINS=

# LLM API -- Groq (OpenAI-compatible), get a key at https://console.groq.com/keys
# Leave LLM_API_KEY empty to run in stub mode (fake but realistic quiz data,
# no external calls) -- useful for building/demoing before the real API is
# wired in.
# NOTE: Groq model availability changes -- if this model 404s, check
# https://console.groq.com/docs/models for the current list.
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
